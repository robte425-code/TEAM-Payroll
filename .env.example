# Neon Postgres (TEAM apps use Vercel Storage -> Neon).
# Copy to `.env` locally. In Vercel: Storage -> Neon -> connect to project -> DATABASE_URL is set automatically.
#
# This app reads DATABASE_URL first, then POSTGRES_URL / POSTGRES_PRISMA_URL (Vercel Neon integration names).
#
# Example shape (replace with your Neon project values):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-....pooler.us-west-2.aws.neon.tech/neondb?sslmode=require
#
DATABASE_URL=
# POSTGRES_URL=

# NextAuth + Azure AD (same sign-in pattern as teamvoc updates)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
ALLOWED_DOMAIN=team-voc.com
ADMIN_EMAILS=

# Postmark transactional email (same vars as TEAM Requests)
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=TEAM Payroll <payroll@team-voc.com>
# POSTMARK_MESSAGE_STREAM=outbound

# --- TEAM internal APIs + SharePoint backups ---
TEAM_INTERNAL_ACCESS_SECRET=
SHAREPOINT_SITE_URL=
# Graph app with Sites.ReadWrite.All + Files.ReadWrite.All (usually the Updates app registration).
# Leave blank to fall back to AZURE_AD_* above (Payroll sign-in app may lack SharePoint access).
SHAREPOINT_AZURE_CLIENT_ID=
SHAREPOINT_AZURE_CLIENT_SECRET=
SHAREPOINT_AZURE_TENANT_ID=
